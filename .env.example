# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE CONFIGURATION
# Obtain these from: Supabase Dashboard -> Project Settings -> API & Database
# ==============================================================================
# 1. REST API Keys (Project Settings -> API)
SUPABASE_URL="https://kbievrhcmpjltdnnjkdw.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 2. Client-side Vite environment variables (prefixed with VITE_)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# 3. Direct PostgreSQL Database Connection URI (Project Settings -> Database -> Connection String)
# Used by: npm run setup:supabase to automatically create tables and seed data
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres"
