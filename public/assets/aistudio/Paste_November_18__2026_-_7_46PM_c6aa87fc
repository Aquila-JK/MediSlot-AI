      if (card.getAttribute('data-patient-id') === patientId) {
        card.classList.add('ring-2', 'ring-primary-container');
        card.classList.remove('ring-0');
      } else {
        card.classList.remove('ring-2', 'ring-primary-container');
        card.classList.add('ring-0');
      }
