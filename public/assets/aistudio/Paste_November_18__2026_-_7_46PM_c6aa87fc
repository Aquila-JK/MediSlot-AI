      let selectedTime = '02:30 PM';
      let selectedMode = 'In-Person (Suite 302)';

      const timeSummary = document.getElementById('selected-summary-time');
      const modeSummary = document.getElementById('selected-summary-mode');
      const bookBtn = document.getElementById('book-slot-btn');

      function updateSummary() {
        if (timeSummary) timeSummary.textContent = `${selectedDate}, ${selectedTime}`;
        if (modeSummary) modeSummary.textContent = selectedMode;
      }

      // Consultation Mode buttons
      const modeButtons = document.querySelectorAll('.type-btn');
      modeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          modeButtons.forEach(b => {
            b.className = 'type-btn py-space-xs px-space-xs rounded-lg font-label-md text-label-md text-center transition-all text-on-surface-variant hover:text-on-surface';
