<script>
  // Interactive notification filtering and status toggle
  document.addEventListener('DOMContentLoaded', () => {
    const filterTabs = document.querySelectorAll('.filter-tab');
    const cards = document.querySelectorAll('.notification-card');
    const markAllBtn = document.getElementById('mark-all-read-btn');

    // Filter switching
    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        filterTabs.forEach(t => {
          t.classList.remove('bg-primary-container', 'text-on-primary', 'shadow-sm');
          t.classList.add('bg-surface-container', 'text-on-surface-variant');
        });
        tab.classList.remove('bg-surface-container', 'text-on-surface-variant');
        tab.classList.add('bg-primary-container', 'text-on-primary', 'shadow-sm');

        const filter = tab.getAttribute('data-filter');

        cards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Mark single notification read/unread
    cards.forEach(card => {
      const toggleBtn = card.querySelector('.toggle-read-btn');
      const deleteBtn = card.querySelector('.delete-btn');
      const unreadDot = card.querySelector('.unread-dot');

      if (toggleBtn) {
        toggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isRead = card.getAttribute('data-read') === 'true';
          if (isRead) {
            card.setAttribute('data-read', 'false');
            card.classList.remove('bg-surface-container-low/70');
            card.classList.add('bg-surface-container-lowest');
            if (unreadDot) unreadDot.style.display = 'inline-block';
            toggleBtn.innerHTML = '<span class="material-symbols-outlined text-headline-sm">check</span>';
          } else {
            card.setAttribute('data-read', 'true');
            card.classList.add('bg-surface-container-low/70');
            card.classList.remove('bg-surface-container-lowest');
            if (unreadDot) unreadDot.style.display = 'none';
            toggleBtn.innerHTML = '<span class="material-symbols-outlined text-headline-sm">mark_email_unread</span>';
          }
        });
      }

      if (deleteBtn) {
        deleteBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          card.style.opacity = '0';
          card.style.transform = 'translateY(-10px)';
          setTimeout(() => {
            card.remove();
          }, 200);
        });
      }
    });

    // Mark all as read
    if (markAllBtn) {
      markAllBtn.addEventListener('click', () => {
        cards.forEach(card => {
          card.setAttribute('data-read', 'true');
          card.classList.add('bg-surface-container-low/70');
          card.classList.remove('bg-surface-container-lowest');
          const unreadDot = card.querySelector('.unread-dot');
          const toggleBtn = card.querySelector('.toggle-read-btn');
          if (unreadDot) unreadDot.style.display = 'none';
          if (toggleBtn) {
            toggleBtn.innerHTML = '<span class="material-symbols-outlined text-headline-sm">mark_email_unread</span>';
          }
        });
      });
    }
  });
