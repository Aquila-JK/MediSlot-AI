<span class="block font-headline-sm text-body-md font-bold text-primary">Oct 28</span>
<span class="block font-label-sm text-label-sm text-secondary">8 slots</span>
</button>
<button class="p-2.5 rounded-xl bg-surface-container text-center hover:bg-surface-container-high transition-colors focus:ring-2 focus:ring-secondary">
<span class="block font-label-sm text-label-sm text-on-surface-variant">Tue</span>
<span class="block font-headline-sm text-body-md font-bold text-primary">Oct 29</span>
<span class="block font-label-sm text-label-sm text-secondary">5 slots</span>
</button>
</div>
</div>
<!-- Available Intelligent Slots -->
<div class="space-y-1.5">
<label class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-semibold">Recommended Intelligent Slots</label>
<div class="grid grid-cols-3 gap-2">
<button class="px-3 py-2.5 rounded-xl bg-surface-container-low hover:bg-surface-container text-center font-label-md text-label-md text-primary font-medium focus:ring-2 focus:ring-secondary">
              09:30 AM
            </button>
<button class="px-3 py-2.5 rounded-xl bg-primary text-on-primary text-center font-label-md text-label-md font-semibold shadow-sm">
              11:00 AM (AI Pick)
            </button>
