<span class="block font-label-sm text-label-sm text-error">2 slots</span>
</button>
<button class="p-2.5 rounded-xl bg-primary-container text-on-primary text-center shadow-sm">
<span class="block font-label-sm text-label-sm text-on-primary-container">Fri</span>
<span class="block font-headline-sm text-body-md font-bold text-on-primary">Oct 25</span>
<span class="block font-label-sm text-label-sm text-secondary-fixed">6 slots</span>
</button>
<button class="p-2.5 rounded-xl bg-surface-container text-center hover:bg-surface-container-high transition-colors focus:ring-2 focus:ring-secondary">
