<script>
  // Filter Tabs Switcher
  function setTab(btn, category) {
    document.querySelectorAll('.tab-btn').forEach(b => {
      b.classList.remove('bg-surface-container-lowest', 'text-primary', 'shadow-sm', 'font-semibold');
      b.classList.add('text-on-surface-variant');
    });
    btn.classList.add('bg-surface-container-lowest', 'text-primary', 'shadow-sm', 'font-semibold');
    btn.classList.remove('text-on-surface-variant');

    const rows = document.querySelectorAll('#appointmentTableBody tr');
    rows.forEach(row => {
      const text = row.innerText.toLowerCase();
      if (category === 'all') {
        row.style.display = '';
      } else if (category === 'pending' && text.includes('pending')) {
        row.style.display = '';
      } else if (category === 'confirmed' && text.includes('confirmed')) {
        row.style.display = '';
      } else if (category === 'completed' && text.includes('completed')) {
        row.style.display = '';
      } else if (category === 'cancelled' && text.includes('cancelled')) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  // Row Action Handlers
  function acceptAppointment(btn, patientName) {
    const row = btn.closest('tr');
    const badge = row.querySelector('td:nth-child(6) span');
    if (badge) {
      badge.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm font-semibold';
      badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-secondary"></span> Confirmed';
    }
    btn.parentElement.innerHTML = `
      <span class="font-label-sm text-label-sm text-secondary font-semibold mr-2">Approved</span>
      <button title="Patient Chart" class="p-1.5 rounded-lg text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors">
        <span class="material-symbols-outlined text-headline-sm">clinical_notes</span>
      </button>
    `;
    showToast('Appointment Approved', `${patientName}'s slot is verified and locked.`);
  }

  function rejectAppointment(btn, patientName) {
    const row = btn.closest('tr');
    row.style.opacity = '0.5';
    const badge = row.querySelector('td:nth-child(6) span');
    if (badge) {
      badge.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-error-container/40 text-error font-label-sm text-label-sm font-semibold';
      badge.innerHTML = 'Rejected';
    }
    btn.parentElement.innerHTML = `
      <span class="font-label-sm text-label-sm text-on-surface-variant mr-2">Declined</span>
      <button title="Patient Chart" class="p-1.5 rounded-lg text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors">
        <span class="material-symbols-outlined text-headline-sm">clinical_notes</span>
      </button>
    `;
    showToast('Appointment Declined', `${patientName}'s triage request was returned to nursing.`);
  }

  function cancelAppointment(btn, patientName) {
    if (confirm(`Confirm cancellation of ${patientName}'s upcoming appointment?`)) {
      const row = btn.closest('tr');
      row.style.opacity = '0.5';
      const badge = row.querySelector('td:nth-child(6) span');
      if (badge) {
        badge.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-error-container/40 text-error font-label-sm text-label-sm font-semibold';
        badge.innerHTML = 'Cancelled';
      }
      showToast('Encounter Cancelled', `Slot for ${patientName} opened for emergency queue.`);
    }
  }

  // Reschedule Modal
  function toggleRescheduleModal(show) {
    const modal = document.getElementById('rescheduleModal');
    if (show) {
      modal.classList.remove('hidden');
    } else {
      modal.classList.add('hidden');
    }
  }

  function openRescheduleFor(patientName, currentSlot) {
    document.getElementById('modalPatientTitle').innerText = `Reschedule: ${patientName}`;
    document.getElementById('modalPatientTarget').innerText = patientName;
    document.getElementById('modalCurrentSlot').innerText = currentSlot;
    toggleRescheduleModal(true);
  }

  function confirmReschedule() {
    toggleRescheduleModal(false);
    showToast('Schedule Shifted', 'Slot synchronized with EMR calendar and patient alerted.');
  }

  // Toast System
  function showToast(title, desc) {
    const toast = document.getElementById('clinicalToast');
    document.getElementById('toastTitle').innerText = title;
    document.getElementById('toastDesc').innerText = desc;
    toast.classList.remove('translate-y-24', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');
    setTimeout(() => {
      toast.classList.remove('translate-y-0', 'opacity-100');
      toast.classList.add('translate-y-24', 'opacity-0');
    }, 3200);
  }

  // Select All Checkbox behavior
  const selectAll = document.getElementById('selectAllCheckbox');
  const bulkBtn = document.getElementById('bulkAcceptBtn');
  if (selectAll) {
    selectAll.addEventListener('change', (e) => {
      const rowChecks = document.querySelectorAll('.row-check');
      rowChecks.forEach(cb => cb.checked = e.target.checked);
      if (bulkBtn) {
        if (e.target.checked) {
          bulkBtn.classList.add('ring-2', 'ring-secondary-fixed');
        } else {
          bulkBtn.classList.remove('ring-2', 'ring-secondary-fixed');
        }
      }
    });
  }

  // Search filter
  const searchInput = document.getElementById('patientSearch');
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase();
      const rows = document.querySelectorAll('#appointmentTableBody tr');
      rows.forEach(r => {
        const text = r.innerText.toLowerCase();
        r.style.display = text.includes(q) ? '' : 'none';
      });
    });
  }

  // Bulk Approve Handler
  if (bulkBtn) {
    bulkBtn.addEventListener('click', () => {
      const checkedRows = document.querySelectorAll('.row-check:checked');
      if (checkedRows.length === 0) {
        showToast('Selection Empty', 'Please tick rows using the checkboxes to bulk process.');
        return;
      }
      checkedRows.forEach(cb => {
        const row = cb.closest('tr');
        const acceptBtn = row.querySelector('button[onclick*="acceptAppointment"]');
        if (acceptBtn) {
          acceptBtn.click();
        }
      });
      showToast('Bulk Action Complete', `${checkedRows.length} requests confirmed.`);
    });
  }
</script></main></div></body></html>

