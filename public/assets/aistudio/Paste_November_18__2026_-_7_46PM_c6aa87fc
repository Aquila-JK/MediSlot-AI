<!-- Inline Micro-interactions Script -->
<script>
    (function initScheduleInteractions() {
      const openModalBtn = document.getElementById('btnOpenNewSlotModal');
      const closeModalBtn = document.getElementById('btnCloseModal');
      const cancelModalBtn = document.getElementById('btnCancelModal');
      const saveSlotBtn = document.getElementById('btnSaveSlot');
      const modal = document.getElementById('newSlotModal');

      function toggleModal(show) {
        if (!modal) return;
        if (show) {
          modal.classList.remove('hidden');
        } else {
          modal.classList.add('hidden');
        }
      }

      if (openModalBtn) openModalBtn.addEventListener('click', () => toggleModal(true));
      if (closeModalBtn) closeModalBtn.addEventListener('click', () => toggleModal(false));
      if (cancelModalBtn) cancelModalBtn.addEventListener('click', () => toggleModal(false));
      if (saveSlotBtn) {
        saveSlotBtn.addEventListener('click', () => {
          toggleModal(false);
        });
      }

