    let activeRole = 'patient';

    function selectRole(role) {
      activeRole = role;

      const patientCard = document.getElementById('patientCard');
      const clinicalCard = document.getElementById('clinicalCard');
      const patientIndicator = document.getElementById('patientIndicator');
      const clinicalIndicator = document.getElementById('clinicalIndicator');

      const togglePatientBtn = document.getElementById('togglePatientBtn');
      const toggleClinicalBtn = document.getElementById('toggleClinicalBtn');

      const patientFormPanel = document.getElementById('patientFormPanel');
      const clinicalFormPanel = document.getElementById('clinicalFormPanel');

      if (role === 'patient') {
        // Card styling
        patientCard.className = "card-active-patient border-2 border-primary-container rounded-2xl p-5 cursor-pointer transition-all duration-300 relative overflow-hidden group";
        clinicalCard.className = "border-2 border-surface-container-high bg-surface-container-low/60 rounded-2xl p-5 cursor-pointer hover:border-gold-400/80 hover:bg-surface-container-lowest transition-all duration-300 relative overflow-hidden group";

        patientIndicator.className = "w-5 h-5 rounded-full bg-primary-container text-white flex items-center justify-center text-xs";
        patientIndicator.innerHTML = '<span class="material-symbols-outlined text-[14px]">check</span>';
        clinicalIndicator.className = "w-5 h-5 rounded-full border border-outline-variant text-transparent flex items-center justify-center text-xs";
        clinicalIndicator.innerHTML = '<span class="material-symbols-outlined text-[14px]">check</span>';

        // Segmented Switch
        togglePatientBtn.className = "tab-active-glow px-5 py-1.5 rounded-full text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer";
        toggleClinicalBtn.className = "px-5 py-1.5 rounded-full text-xs font-bold text-on-surface-variant hover:text-primary transition-all flex items-center gap-1.5 cursor-pointer";

