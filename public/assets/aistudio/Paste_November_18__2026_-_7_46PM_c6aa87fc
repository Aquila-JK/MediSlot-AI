<!-- Notification Toast for Dynamic Feedback -->
<div class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none flex items-center gap-3 px-space-md py-space-sm bg-primary-container text-on-primary rounded-xl shadow-xl border border-secondary/20" id="clinicalToast">
<span class="material-symbols-outlined text-secondary-fixed text-headline-sm" id="toastIcon">check_circle</span>
<div>
<span class="block font-label-md text-label-md font-semibold" id="toastTitle">Action Finalized</span>
<span class="block font-label-sm text-label-sm text-on-primary-container" id="toastDesc">Clinical state updated across suite.</span>
</div>
</div>
