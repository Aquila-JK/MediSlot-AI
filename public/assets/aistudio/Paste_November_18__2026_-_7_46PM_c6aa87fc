          btn.className = 'type-btn py-space-xs px-space-xs rounded-lg font-label-md text-label-md text-center transition-all bg-surface-container-lowest text-primary shadow-sm';
          selectedMode = btn.getAttribute('data-mode') === 'in-person' ? 'In-Person (Suite 302)' : 'Secure HD Video';
          updateSummary();
        });
      });

      // Date Selection Cards
      const dateButtons = document.querySelectorAll('.date-card');
      dateButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          dateButtons.forEach(b => {
            b.className = 'date-card p-space-xs rounded-xl flex flex-col items-center justify-center transition-all bg-surface-container-low hover:bg-surface-container text-on-surface';
          });
          btn.className = 'date-card p-space-xs rounded-xl flex flex-col items-center justify-center transition-all bg-primary text-on-primary shadow-sm';
          const dayName = btn.querySelector('span:first-child')?.textContent?.trim() || '';
          selectedDate = dayName.toUpperCase() === 'TODAY' ? 'Today' : `${dayName} Oct`;
          updateSummary();
        });
      });

      // Time Slot Pills
      const timeButtons = document.querySelectorAll('.time-slot-pill');
      timeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          timeButtons.forEach(b => {
            b.className = 'time-slot-pill py-space-xs px-space-sm rounded-lg font-label-md text-label-md text-center transition-all bg-surface-container-low hover:bg-surface-container text-on-surface';
          });
          btn.className = 'time-slot-pill py-space-xs px-space-sm rounded-lg font-label-md text-label-md text-center transition-all bg-primary-container text-on-primary shadow-sm';
          selectedTime = btn.getAttribute('data-time') || '02:30 PM';
          updateSummary();
        });
      });

      // Confirmation feedback
      if (bookBtn) {
        bookBtn.addEventListener('click', () => {
          const originalText = bookBtn.innerHTML;
          bookBtn.innerHTML = `
            <span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span>
            <span>Confirming with St. Jude Clinic...</span>
